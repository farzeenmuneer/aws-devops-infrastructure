// ============================================
// AWS Production Infrastructure - Jenkins Pipeline
// Declarative Pipeline with Groovy scripting
// ============================================

pipeline {
    agent any

    environment {
        REGISTRY     = 'aws-production-infrastructure'
        IMAGE_NAME   = 'prod-app'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        APP_VERSION  = '1.0.0'
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Cloning source code from GitHub...'
                checkout scm
            }
        }

        stage('Code Quality Check') {
            steps {
                echo 'Validating Python application syntax...'
                sh '''
                    python -m py_compile app/app.py && echo "Syntax OK"
                '''
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                echo 'Scanning application source for vulnerabilities...'
                sh '''
                    if command -v trivy >/dev/null 2>&1; then
                        trivy fs --severity HIGH,CRITICAL --exit-code 1 app/ || echo "Trivy found issues"
                    else
                        echo "Trivy not installed - skipping filesystem scan"
                    fi
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                sh '''
                    docker build -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ./app
                    docker tag ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                echo 'Scanning built container image for vulnerabilities...'
                sh '''
                    if command -v trivy >/dev/null 2>&1; then
                        trivy image --severity HIGH,CRITICAL ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || echo "Image scan completed with findings"
                    else
                        echo "Trivy not installed - skipping image scan"
                    fi
                '''
            }
        }

        stage('Push to Registry') {
            steps {
                echo "Pushing ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} (simulated)"
                sh '''
                    echo "Image pushed: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application (handled by ArgoCD GitOps)...'
                sh '''
                    echo "Deployment manifest updated"
                    echo "ArgoCD will sync cluster state"
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded for build #${BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline failed for build #${BUILD_NUMBER}"
        }
        always {
            echo "Pipeline run complete"
        }
    }
}